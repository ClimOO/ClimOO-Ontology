@prefix : <https://www.w3id.org/climoo/climoo-picco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://www.w3id.org/climoo/climoo-picco#> .

<https://www.w3id.org/climoo/climoo-picco> rdf:type owl:Ontology ;
                                            owl:versionIRI :picco-v1.0.0 ;
                                            owl:imports <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/picco%20imports/pato-imports.ttl> ,
                                                        <https://www.w3id.org/climoo/climoo-plastico#plastico-v1.0.0> ,
                                                        <https://www.w3id.org/climoo/climoo-sdc2#sdc2-v1.0.0> ;
                                            <http://purl.org/dc/terms/contributor> "Giorgio A. Ubbiali" ,
                                                                                   "Ludger Jansen" ;
                                            <http://purl.org/dc/terms/creator> "Giorgio A. Ubbiali" ;
                                            <http://purl.org/dc/terms/description> "ClimOO Ontology is a reference ontology, modeling plastics, (micro-)plastic pollution, climate change, and their interrelation, with a primary focus on agricultural systems. The ClimOO Ontology is structured in a suite of nested ontological modules. The Plastics Interconnecting with Climate Change Ontology (PICCO) module extends PlasticO and ClimOO-SDC2 modules to represent impacts of and interrelations between (micro-)plastic pollution and climate change. A particular emphasis is dedicated such to phenomena with respect to soils. "@en ;
                                            <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                                            <http://purl.org/dc/terms/title> "ClimOO Ontology - PICCO module"@en ;
                                            owl:versionInfo "2026-07-16"@en ,
                                                            "V1.0.0."@en ;
                                            <http://www.w3.org/2004/02/skos/core#note> """Repository: https://www.w3id.org/climoo/repo
Documentation webpage: https://www.w3id.org/climoo/docs"""@en ,
                                                                                       "The most recent version of this file is available on GitHub at the following link: https://www.w3id.org/climoo/climoo-picco."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym
<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom
<https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> rdf:type owl:AnnotationProperty .


###  https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity
<https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000015
<http://purl.obolibrary.org/obo/BFO_0000015> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/BFO_0000016
<http://purl.obolibrary.org/obo/BFO_0000016> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/BFO_0000019
<http://purl.obolibrary.org/obo/BFO_0000019> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/GO_0008150
<http://purl.obolibrary.org/obo/GO_0008150> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/PATO_0000125
<http://purl.obolibrary.org/obo/PATO_0000125> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/PATO_0000973
<http://purl.obolibrary.org/obo/PATO_0000973> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/PATO_0001018
<http://purl.obolibrary.org/obo/PATO_0001018> rdf:type owl:Class .


###  https://w3id.org/pmd/co/PMD_0020115
<https://w3id.org/pmd/co/PMD_0020115> rdf:type owl:Class .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000417
:ClimOO_0000417 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000304> ;
                rdfs:comment "Subclasses for specific subjects of interest, such as fauna, plants, humans, etc., can be added as needed." ;
                rdfs:label "process of increasing water scarcity" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A climate system process that leads to a widening of the gap between the demand and supply of water with respect to a subject of interest." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://unterm.un.org/unterm2/en/view/da8312f8-9e7a-44dc-a561-17480161930b" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000418
:ClimOO_0000418 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:comment "This process can be seen at different levels of granularity, such as molecular, biological, and physiological levels. Definition focus can slightly change. We tried to accommodate possible views here." ;
                rdfs:label "organism respiration process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that allows living organisms to produce energy and convert organic matter, involving the consumption of molecular oxygen captured from the organism's surroundings and the release of carbon dioxide." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://unterm.un.org/unterm2/en/view/f9a1c142-43f5-4f07-b518-baacd482b234; http://opendata.inra.fr/anaeeThes/c_1406131609604" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000419
:ClimOO_0000419 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000418 ;
                rdfs:label "microbial respiration process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A respiration process that has, as main participants, some microorganisms." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000420
:ClimOO_0000420 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0000973> ;
                rdfs:label "soil porosity" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A porosity of some portion of soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/ENVO_09200004" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000421
:ClimOO_0000421 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Plant_Physical_Process> ;
                rdfs:label "plant uptake of microplastics" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plant physical process where some microplastic debris particles enter a plant." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000422
:ClimOO_0000422 rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020115> ;
                rdfs:label "plastic aerosol" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An aerosol composed of plastic debris particles." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000423
:ClimOO_0000423 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Emission_of_Greenhouse_Gas> ;
                rdfs:label "plastic debris-induced GHG emission process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process of emission of greenhouse gas caused by plastic debris. Plastic debris may induce GHG emissions or alter GHG emission patterns." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000424
:ClimOO_0000424 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-plastico#ClimOO_0000265> ;
                rdfs:label "airborne plastic deposition" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A transportation process during which micro-and nano-plastic debris particles suspended in the atmosphere settle on the oceans or land, via direct surface delivery (dry deposition) or via rain and snow (wet deposition)." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "10.1371/journal.pone.0199241; 10.3390/ijerph191912252" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000425
:ClimOO_0000425 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000427 ;
                rdfs:comment "Reference to microorganism colonization and biofilm formation phases can be added as needed." ;
                rdfs:label "biofilm formation process on soil plastic debris" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biofilm formation process that occurs on plastic debris in soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000426
:ClimOO_0000426 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000427 ;
                rdfs:label "biofilm formation process on plastic debris" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biofilm formation process that occurs on plastic debris." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000427
:ClimOO_0000427 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                rdfs:label "biofilm formation process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biological process in which microorganisms, including bacteria and microalgae, grow, adhering to each other and to a surface in a layered structure, due to the production of an extracellular polymeric substance (EPS) matrix, resulting in changes in the microorganisms' growth rate and gene transcription." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "10.1007/s42770-021-00624-x; http://purl.obolibrary.org/obo/GO_0042710; https://www.sciencedirect.com/topics/engineering/biofilm-formation" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000428
:ClimOO_0000428 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Emission_of_Non-CO2_Greenhouse_Gas> ;
                rdfs:label "soil CH4 emission process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An emission process of methane that occurs from the soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000429
:ClimOO_0000429 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Emission_of_Non-CO2_Greenhouse_Gas> ;
                rdfs:label "soil N2O emission process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An emission process of nitrous oxide that occurs from the soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000430
:ClimOO_0000430 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000428 ;
                rdfs:label "plastic debris-driven soil CH4 emission process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An emission process of methane that occurs from soil when some soil plastic debris is present." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000431
:ClimOO_0000431 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000429 ;
                rdfs:label "plastic debris-driven soil N2O emission process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An emission process of nitrous oxide that occurs from soil when some soil plastic debris is present." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000432
:ClimOO_0000432 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Plant_Physical_Process> ;
                rdfs:label "weed and crop competition process" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plant physical process occurring in an agricultural field in which weeds and crops interact to contend for the same resources for survival, primarily water, nutrients, light, and carbon dioxide, reducing agricultural outputs." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://aims.fao.org/aos/agrovoc/c_35265; see also: https://lod.nal.usda.gov/nalt/30169" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000433
:ClimOO_0000433 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0000125> ;
                rdfs:label "biomass - quality" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A mass that inheres in a bearer in virtue of the total amount of biological entities that are part of such bearer." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://opendata.inrae.fr/PO2/Ontology/TransformON/c_5a4AaY" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000434
:ClimOO_0000434 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000433 ;
                rdfs:label "microbial biomass - quality" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biomass that inheres in a bearer in virtue of the total amount of microorganisms that are part of such bearer." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://opendata.inrae.fr/PO2/Ontology/TransformON/c_NtH53B" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000435
:ClimOO_0000435 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:label "soil aeration" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that leads to the exchange of gases, primarily CO2 and O2, between a portion of soil and a portion of the atmosphere nearby." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000436
:ClimOO_0000436 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0001018> ;
                rdfs:comment "This wants to be a generalization of the PATO class." ;
                rdfs:label "structure - quality" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A morphology quality inhering in a bearer by virtue of the bearer's relative position, shape, arrangements and connectivity of a bearer's various parts; the pattern underlying its form." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/PATO_0000141" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000437
:ClimOO_0000437 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000436 ;
                rdfs:label "soil structure" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A structure that inheres in a portion of soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000438
:ClimOO_0000438 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-sdc2#Biodiversity> ;
                rdfs:comment "We envision implementations of this class with respect to different microbial populations, alternative interpretations of biodiversity, and related indexes." ;
                rdfs:label "soil microbial diversity" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biodiversity of microorganisms in a portion of soil." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000439
:ClimOO_0000439 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                rdfs:label "soil microbial composition" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A quality of soil given by the presence of resident microorganisms." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000440
:ClimOO_0000440 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:comment "This class and the related subclasses are provisional. As soon as a solid representation of causation is available, we envision implementing this model. Subclasses for specific types of alterations can be added as needed." ;
                rdfs:label "plastic debris-driven alteration process of soil properties" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in a soil caused by some plastic debris and has as its output a portion of soil exhibiting different soil properties." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000441
:ClimOO_0000441 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000440 ;
                rdfs:label "plastic debris-driven alteration process of soil microbe metabolism" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in soil caused by some plastic debris and has as its output the resident microbial communities with a different metabolism." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000442
:ClimOO_0000442 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000441 ;
                rdfs:label "plastic debris-driven alteration process of soil microbial biomass" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in soil caused by some plastic debris and has as its output a portion of soil with a different microbial biomass." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000443
:ClimOO_0000443 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000442 ;
                rdfs:label "plastic debris-driven alteration process of soil microbial community composition" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in soil caused by some plastic debris and has as its output a portion of soil with a different composition of the resident microbial communities." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000444
:ClimOO_0000444 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000443 ;
                rdfs:label "plastic debris-driven alteration process of soil porosity" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in soil caused by some plastic debris and has as its output a portion of soil with a different porosity." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000445
:ClimOO_0000445 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000444 ;
                rdfs:label "plastic debris-driven alteration process of soil pore spaces for aeration" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plastic debris-driven alteration process of soil structure that has as its output a portion of soil with a different structure of the aeration pore spaces." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-picco#ClimOO_0000446
:ClimOO_0000446 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000445 ;
                rdfs:label "plastic debris-driven alteration process of soil structure" ;

   owl:annotatedSource <http://purl.obolibrary.org/obo/RO_0018040> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000112> ;
   owl:annotatedTarget "pyranine (CHEBI:52083) has parent hydride pyrene (CHEBI:39106). Pyrene is molecule with four fused benzene rings, whereas pyranine has the same core ring structure with additional sulfates." ;

###  https://www.w3id.org/climoo/climoo-sdc2#body_of_water
:body_of_water rdf:type owl:Class ;
               rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/HydrographicFeature> ,
                               :Hydrologic_Material_Entity ,
                               [ owl:intersectionOf ( :Hydrologic_Material_Entity
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000178> ;
                                                        owl:someValuesFrom :Water
                                                      ]

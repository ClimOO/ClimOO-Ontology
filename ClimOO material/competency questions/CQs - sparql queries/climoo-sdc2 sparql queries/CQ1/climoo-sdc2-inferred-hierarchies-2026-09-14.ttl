                                            rdfs:label "has exposure stimulus" .


###  http://purl.obolibrary.org/obo/RO_0002314
<http://purl.obolibrary.org/obo/RO_0002314> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002502> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "q characteristic of part of w if and only if there exists some p such that q inheres in p and p part of w." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000116> "Because part_of is transitive, inheres in is a sub-relation of characteristic of part of" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "inheres in part of" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <http://www.ncbi.nlm.nih.gov/pubmed/20064205> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://purl.obolibrary.org/obo/RO_0001900> <http://purl.obolibrary.org/obo/RO_0001901> ;
                                            rdfs:label "characteristic of part of"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/reflexivity/> .


###  http://purl.obolibrary.org/obo/RO_0002323
<http://purl.obolibrary.org/obo/RO_0002323> rdf:type owl:ObjectProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A mereological relationship or a topological relationship" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;

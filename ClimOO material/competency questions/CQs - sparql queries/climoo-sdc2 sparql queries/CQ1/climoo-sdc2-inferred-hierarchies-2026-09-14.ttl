<http://purl.obolibrary.org/obo/RO_0002509> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002131> ,
                                                               <http://purl.obolibrary.org/obo/RO_0002506> ,

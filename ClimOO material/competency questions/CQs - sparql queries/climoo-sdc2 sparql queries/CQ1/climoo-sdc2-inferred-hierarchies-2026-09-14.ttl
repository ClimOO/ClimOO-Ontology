###  http://purl.obolibrary.org/obo/RO_0012010
<http://purl.obolibrary.org/obo/RO_0012010> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002305> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "p removes input for q iff p is causally upstream of q, there exists some c such that p has_input c and q has_input c, p reduces the levels of c, and c is rate limiting for execution of q." ;

                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000185> ;
                                                         owl:someValuesFrom :ClimOO_0000315
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000211> ;
                                                         owl:someValuesFrom :ClimOO_0000311
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/RO_0002163> ;
                                                         owl:someValuesFrom :ClimOO_0000313
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000185> ;
                                                         owl:allValuesFrom :ClimOO_0000315
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                owl:disjointWith :ClimOO_0000313 ;
                rdfs:label "climate system"@en ;
                rdfs:seeAlso "http://purl.obolibrary.org/obo/ENVO_01001364" ,
                             "http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Climate_System_Role and subclasses" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A complex system that bears a climate disposition. Earth climate systemt is mainly composed of the atmosphere, the hydrosphere, the cryosphere, the lithosphere and the biosphere."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://www.ipcc.ch/report/ar6/syr/downloads/report/IPCC_AR6_SYR_FullVolume.pdf" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000307 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000299
:ClimOO_0000299 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( <http://www.ontologyrepository.com/CommonCoreOntologies/MeasurementInformationContentEntity>
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.ontologyrepository.com/CommonCoreOntologies/is_a_measurement_of> ;
                                                             owl:someValuesFrom :ClimOO_0000300
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/MeasurementInformationContentEntity> ;
                rdfs:label "climate variability - measurement"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An information content entity that is a measurement of the deviations of climate over a period of time from the long-term climate statistics for the corresponding calendar period."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://unterm.un.org/unterm2/en/view/e0be578f-2cfc-401c-b536-7d5de7fe8559" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000300
:ClimOO_0000300 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000138> ;
                                  owl:someValuesFrom :ClimOO_0000304
                                ] ;
                rdfs:label "climate variability - process profile"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process profile that is an occurrent part of some climate system process and is measured by some climate variability - measurement."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://unterm.un.org/unterm2/en/view/e0be578f-2cfc-401c-b536-7d5de7fe8559" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000301
:ClimOO_0000301 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000304 ;
                rdfs:label "climate change"@en ;
                rdfs:seeAlso "http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Climate_Change and subclasses."@en ,
                             "http://purl.obolibrary.org/obo/ENVO_01000629" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A climate system process that alters the climate of a climate system for an extended period of time (typically decades or longer), and can be identified by the variation of the mean and/or the variability of the attributes, according to which that climate is statistically described."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://www.ipcc.ch/report/ar6/syr/downloads/report/IPCC_AR6_SYR_FullVolume.pdf" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000307 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000302
:ClimOO_0000302 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( <https://www.w3id.org/sco#SCO_0000028>
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000176> ;
                                                             owl:someValuesFrom :ClimOO_0000298
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf <https://www.w3id.org/sco#SCO_0000028> ;
                owl:disjointWith :ClimOO_0000312 ;
                rdfs:comment "Reference to stakeholders of climate systems can be added as needed."@en ;
                rdfs:label "climate system component"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A complex system component that is part of a climate system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Climate_System_Component" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000303
:ClimOO_0000303 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                  owl:someValuesFrom :atmosphere
                                ] ;
                rdfs:comment "We refer to weather primarily at the mesospheric level of analysis. We do not refer to weather, for instance, when we deal with the molecular composition of the atmosphere."@en ;
                rdfs:label "atmospheric weather"@en ;
                rdfs:seeAlso "http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Weather and subclasses."@en ,
                             "http://purl.obolibrary.org/obo/ENVO_01001078" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A quality that is realized in an atmospheric process and is described in terms of meteorological attributes, such as temperature, precipitation, atmospheric pressure, wind, and humidity."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://wmo.int/topics/weather; https://unterm.un.org/unterm2/en/" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000307 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000304
:ClimOO_0000304 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000117> ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( :ClimOO_0000316
                                                                     :ClimOO_0000318
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000167> ;
                                  owl:someValuesFrom :ClimOO_0000298
                                ] ;
                rdfs:comment """ClimOO Ontology comment:
We did not deal with climate change adaptation and mitigation. We plan this as part of next round of implementations. See also:
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Adaptation and subclasses
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Mitigation and subclasses
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Impact_Reduction and subclasses"""@en ,
                             "Climate system processes have the climate system as participant, meaning that any occurrence happening in a portion of a climate system component/climate system component also affects the overall climate system."@en ,
                             "Currently, we have not included event classes (with the exception of recreating the flooding and drought classes under the climate system process hierarchy), given their relevance for ClimOO Ontology purposes, due to the ambiguous characterization of events with respect to the BFO characterization of processes. We envision discussions with matter experts to implement this part of the model. For the moment, see http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Event and subclasses."@en ,
                             """The representations of impacts, causes, and effects provided by CCO/SDC Onto appear excessively simplified and superficial. In addition, given the hierarchical position of several classes, it is not justified why the represented processes should be seen solely as causes or effects. See, for instance, the model of change drivers proposed in Ubbiali (2025). We envision implementations to revise and include these classes in the near future. 
Please see these classes and subclasses:
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Disaster_Consequence
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Effect_of_Land_Management
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Impact
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Severe_Weather_Effect

Ubbiali, G. A. (2025). Designing Foundational Strategies for Developing a Family of Food Systems Sustainability Ontologies [PhD Thesis, UNIMI]. https://air.unimi.it/handle/2434/1161515"""@en ,
                             "We did not include forcing, external natural change, and fiat process part classes as beyond the current scopes of the ClimOO Ontology. Implementations will deal with such classes. See http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Forcing and subclasses; http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Fiat_Process_Part and subclasses."@en ,
                             """We did not include the following classes yet. Implementations will deal with relevant ecosystem features as needed.
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Functioning and subclasses.
http://www.semanticweb.org/Davarpanah-Babaie/ontologies/2021/9/ClimateOnSDG1267#Maintain_Ecosystem"""@en ;
                rdfs:label "climate system process"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that pertains to a climate system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000306 ,
                                                       :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000305
:ClimOO_0000305 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000304 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000167> ;
                                  owl:someValuesFrom :ClimOO_0000303
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000167> ;
                                  owl:someValuesFrom :atmosphere
                                ] ;
                rdfs:comment "Subclasses do not aim to be an exhaustive classification of atmospheric processes."@en ;
                rdfs:label "atmospheric process"@en ;
                rdfs:seeAlso "http://purl.obolibrary.org/obo/ENVO_02500003" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that pertains to some portion of atmosphere."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> ;
                <https://www.w3id.org/sco#SCO_0000039> :ClimOO_0000308 .


###  https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000309
:ClimOO_0000309 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :ClimOO_0000302
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://www.w3id.org/sco#SCO_0000038> ;
                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( :ClimOO_0000316
                                                                                                :ClimOO_0000318
                                                                                              )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :ClimOO_0000302 ,
                                <https://www.w3id.org/sco#SCO_0000034> ;
                owl:disjointWith :ClimOO_0000314 ;

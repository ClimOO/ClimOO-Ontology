                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_go_annotation_extension> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_go_ontology> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_gocam> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "has input"@en ;
                                            rdfs:seeAlso "https://wiki.geneontology.org/Has_input"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/RO_0002234
<http://purl.obolibrary.org/obo/RO_0002234> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "produces" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_go_annotation_extension> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_go_ontology> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_gocam> ,
                                                                                                    <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "has output"@en ;
                                            rdfs:seeAlso "https://wiki.geneontology.org/Has_output"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/RO_0002238
<http://purl.obolibrary.org/obo/RO_0002238> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "X 'has component participant' Y means X 'has participant' Y and there is a cardinality constraint that specifies the numbers of Ys." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> """This object property is needed for axioms using has_participant with a cardinality contrainsts; e.g., has_particpant min 2 object. However, OWL does not permit cardinality constrains with object properties that have property chains (like has_particant) or are transitive (like has_part).

If you need an axiom that says 'has_participant min 2 object', you should instead say 'has_component_participant min 2 object'.""" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0001-9625-1899> ;
                                            rdfs:label "has component participant"@en .


###  http://purl.obolibrary.org/obo/RO_0002240
<http://purl.obolibrary.org/obo/RO_0002240> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002244> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A broad relationship between an exposure event or process and any entity (e.g., an organism, organism population, or an organism part) that interacts with an exposure stimulus during the exposure event." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "ExO:0000001" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "has exposure receptor" .


###  http://purl.obolibrary.org/obo/RO_0002241
<http://purl.obolibrary.org/obo/RO_0002241> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002309> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A broad relationship between an exposure event or process and any agent, stimulus, activity, or event that causes stress or tension on an organism and interacts with an exposure receptor during an exposure event." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "ExO:0000000" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "has exposure stressor" .


###  http://purl.obolibrary.org/obo/RO_0002242
<http://purl.obolibrary.org/obo/RO_0002242> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002244> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A broad relationship between an exposure event or process and a process by which the exposure stressor comes into contact with the exposure receptor" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "ExO:0000055" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "has exposure route" .


###  http://purl.obolibrary.org/obo/RO_0002243
<http://purl.obolibrary.org/obo/RO_0002243> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002244> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A broad relationship between an exposure event or process and the course takes from the source to the target." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "http://purl.obolibrary.org/obo/ExO_0000004"^^xsd:anyURI ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;

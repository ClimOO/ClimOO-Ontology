                                            <http://purl.obolibrary.org/obo/IAO_0000118> "directly consumes" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "This is likely to be obsoleted. A candidate replacement would be a new relation 'has bound input' or 'has substrate'" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "has direct input"@en .



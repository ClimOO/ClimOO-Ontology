                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-7073-9172> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "has boundary"@en ,
                                                                                         "has_2D_boundary"@en .



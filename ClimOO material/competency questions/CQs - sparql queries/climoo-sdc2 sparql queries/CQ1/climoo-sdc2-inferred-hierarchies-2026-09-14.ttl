###  http://purl.obolibrary.org/obo/RO_0002224
<http://purl.obolibrary.org/obo/RO_0002224> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ,
                                                               <http://purl.obolibrary.org/obo/RO_0002222> ;
                                            rdf:type owl:TransitiveProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "Every insulin receptor signaling pathway starts with the binding of a ligand to the insulin receptor" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) ∧ ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ,
                                                                                         "Chris Mungall" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "started by" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "starts with"@en .


###  http://purl.obolibrary.org/obo/RO_0002229
<http://purl.obolibrary.org/obo/RO_0002229> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000050> ,
                                                               <http://purl.obolibrary.org/obo/RO_0002222> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "inverse of ends with" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ,
                                                                                         "Chris Mungall" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "ends"@en .


###  http://purl.obolibrary.org/obo/RO_0002230
<http://purl.obolibrary.org/obo/RO_0002230> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ,
                                                               <http://purl.obolibrary.org/obo/RO_0002222> ;
                                            rdf:type owl:TransitiveProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) > α(x) ∧ ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ,
                                                                                         "Chris Mungall" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "finished by" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "ends with"@en .


###  http://purl.obolibrary.org/obo/RO_0002231
<http://purl.obolibrary.org/obo/RO_0002231> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002479> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x 'has starts location' y if and only if there exists some process z such that x 'starts with' z and z 'occurs in' y" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "starts with process that occurs in" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/ro/subsets#ro-eco> ;
                                            rdfs:label "has start location"@en .


###  http://purl.obolibrary.org/obo/RO_0002232

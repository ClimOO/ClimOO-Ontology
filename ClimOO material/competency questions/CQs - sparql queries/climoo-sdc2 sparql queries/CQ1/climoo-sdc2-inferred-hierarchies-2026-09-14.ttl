                                                                      <https://www.w3id.org/sco#SCO_0000015>
                                                                      <https://www.w3id.org/sco#SCO_0000026>
                                                                      <https://www.w3id.org/sco#SCO_0000028>
                                                                    )
                                                      ]
                                 ]
                               ) ;
            rdf:type owl:Class .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://www.w3id.org/sco#SCO_0000005> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid987 ;
   rdfs:comment "To amend this axiom in case worth is associated with some object aggregate that is part of the complex system or complex system environment of interest. To extend this axiom to also cover the \"object aggregate\" class."
 ] .



                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002244> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "X has exposure medium Y if X is an exposure event (process), Y is a material entity, and the stimulus for X is transmitted or carried in Y." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "ExO:0000083" ;

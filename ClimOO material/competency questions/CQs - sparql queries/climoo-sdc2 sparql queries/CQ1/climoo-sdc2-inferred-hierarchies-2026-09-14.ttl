                                            <http://www.geneontology.org/formats/oboInOwl#creation_date> "2023-10-12T10:02:42Z"^^xsd:dateTime ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "negatively regulates in other organism" ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.oboInOwllibrary.org/oboInOwl/valid_for_go_ontology> ;
                                            rdfs:label "negatively regulates in another organism"@en .



###  http://purl.obolibrary.org/obo/RO_0011003
<http://purl.obolibrary.org/obo/RO_0011003> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002566> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The entity A has an activity that regulates the quantity or abundance or concentration of the entity B." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0003-4639-4431> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "regulates quantity of" .


###  http://purl.obolibrary.org/obo/RO_0011007
<http://purl.obolibrary.org/obo/RO_0011007> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0011023> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> """The entity A has an activity that down-regulates by repression the quantity of B. The down-regulation is due to A having an effect on an intermediate entity (typically a DNA or mRNA element) which can produce B.

For example, protein A (transcription factor) indirectly decreases by repression the quantity of protein B (gene product) if and only if A negatively regulates the process of transcription or translation of a nucleic acid element that produces B.""" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0003-4639-4431> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "decreases by repression quantity of" .


###  http://purl.obolibrary.org/obo/RO_0011008
<http://purl.obolibrary.org/obo/RO_0011008> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0011024> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> """The entity A has an activity that up-regulates by expression the quantity of B. The up-regulation is due to A having an effect on an intermediate entity (typically a DNA or mRNA element) which can produce B.

For example, protein A (transcription factor) indirectly increases by expression the quantity of protein B (gene product) if and only if A positively regulates the process of transcription or translation of a nucleic acid element that produces B.""" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0003-4639-4431> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            rdfs:label "increases by expression quantity of" .


###  http://purl.obolibrary.org/obo/RO_0011009
<http://purl.obolibrary.org/obo/RO_0011009> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0011021> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The entity A has an activity that directly positively regulates the quantity of B." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0003-4639-4431> ;

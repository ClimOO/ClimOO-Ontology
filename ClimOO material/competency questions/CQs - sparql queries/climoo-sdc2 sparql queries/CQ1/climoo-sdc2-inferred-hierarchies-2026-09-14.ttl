                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ro.owl> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000589> "causally influences (entity-centric)" ;
                                            rdfs:label "causally influences" .



###  http://purl.obolibrary.org/obo/PO_0009001
<http://purl.obolibrary.org/obo/PO_0009001> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/PO_0025496> ,
                                                            <http://purl.obolibrary.org/obo/UBERON_0001062> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A multi-tissue plant structure (PO:0025496) that develops from a gynoecium (PO:0009062), or a single carpel (PO:0009030), and at maturity may have as parts one or more seeds (PO:0009010)." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/po.owl> ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> "PO:0020067" ,
                                                                                                            "PO:0020068" ,
                                                                                                            "PO:0020069" ,
                                                                                                            "PO:0020070" ,
                                                                                                            "PO:0020071" ,

###  http://purl.obolibrary.org/obo/BFO_0000040
<http://purl.obolibrary.org/obo/BFO_0000040> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/COB_0000022
<http://purl.obolibrary.org/obo/COB_0000022> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000465> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/cob.owl> ;
                                             rdfs:label "organism"@en .


###  http://purl.obolibrary.org/obo/FOODON_00001002
<http://purl.obolibrary.org/obo/FOODON_00001002> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00002403> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "Food material for humans and animals which is processed with the intention that it be consumable as a whole or added to other food products."@en ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000117> "Damion Dooley"@en ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000118> "Foodon product type"@en ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000119> "https://en.wikipedia.org/wiki/Food"^^xsd:anyURI ;
                                                 rdfs:comment "The FoodOn \"food product\" class is provided as a branch under which new food product categories and food products themselves can be placed. Here classes are provided to differentiate a food product by its food composition, processing and/or consumption characteristics. This avoids brand name products but it may include generic food dish categories. It has a much greater depth and polyhierarchy than other agency product type schemes have in an effort to group related products together.  The upper level basis of this tree originated in the environment ontology (ENVO) and from the US Code of Federal Regulations."@en ;
                                                 rdfs:label "food product"@en .


###  http://purl.obolibrary.org/obo/FOODON_00001015
<http://purl.obolibrary.org/obo/FOODON_00001015> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00001002> ,
                                                                 <http://purl.obolibrary.org/obo/FOODON_00004331> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "A food product which has as a defining ingredient some plant material."@en ;
                                                 <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-8844-9165> ;
                                                 rdfs:label "plant food product"@en .


###  http://purl.obolibrary.org/obo/FOODON_00001057
<http://purl.obolibrary.org/obo/FOODON_00001057> rdf:type owl:Class ;
                                                 owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/FOODON_00001261>
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_03411140>
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ] ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00001261> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_03411140>
                                                                 ] ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "A food product derived from plant fruit."@en ;
                                                 rdfs:comment """ClimOO Ontology comment:
We exclude the axiom towards the “fruit or fruit product (us cfr)” as beyond the purposes of ClimOO. We did not intend to alter the original FoodOn model but to maintain ClimOO hierarchies compact and focused on features relevant for the domain. This axiom can be readded as needed. We envision discussions with FoodOn curators to accommodate models.                                            

The Excluded axiom:
rdfs:subClassOf [ rdf:type owl:Restriction ;
owl:onProperty <http://purl.obolibrary.org/obo/RO_0002350> ;
owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_03400143>
                                                                 ] ;"""@en ;
                                                 rdfs:label "plant fruit food product"@en .


###  http://purl.obolibrary.org/obo/FOODON_00001158
<http://purl.obolibrary.org/obo/FOODON_00001158> rdf:type owl:Class ;
                                                 owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/FOODON_00001057>
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/PO_0030110>
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ] ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00001057> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/PO_0030110>
                                                                 ] ;
                                                 <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "pomes"@en ;
                                                 rdfs:label "pomaceous fruit food product"@en .


###  http://purl.obolibrary.org/obo/FOODON_00001261
<http://purl.obolibrary.org/obo/FOODON_00001261> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00001015> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_03411579>
                                                                 ] ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "A plant food product which derives from one or more vegetables."@en ;
                                                 rdfs:comment """ClimOO Ontology comment:
We exclude the axiom towards the “vegetable or vegetable product (us cfr)” as beyond the purposes of ClimOO. We did not intend to alter the original FoodOn model but to maintain ClimOO hierarchies compact and focused on features relevant for the domain. This axiom can be readded as needed. We envision discussions with FoodOn curators to accommodate models.

The excluded axiom: 

rdfs:subClassOf [ rdf:type owl:Restriction ;
owl:onProperty <http://purl.obolibrary.org/obo/RO_0002350> ;
owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_03400152>
                                                                 ] ;"""@en ,
                                                              "FAO definition for vegetable: \"Vegetables are plants cultivated both as field crops and garden crops, both in the open and under glass.\" and also: \"Vegetables are grouped according to botanic characteristics as follows: leafy or stem vegetables (e.g., cabbage); fruit-bearing vegetables (e.g., melons); flower vegetables (e.g., cauliflowers); root, bulb and tuberous vegetables (e.g., onion); leguminous vegetables (e.g., green peas); other vegetables (e.g., green maize and mushrooms).\""@en ;
                                                 rdfs:label "vegetable food product"@en ;
                                                 rdfs:seeAlso <https://www.fao.org/economic/the-statistics-division-ess/methodology/methodology-systems/crops-statistics-concepts-definitions-and-classifications/en/> .


###  http://purl.obolibrary.org/obo/FOODON_00001611
<http://purl.obolibrary.org/obo/FOODON_00001611> rdf:type owl:Class ;
                                                 owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/FOODON_00001158>
                                                                                            [ rdf:type owl:Restriction ;
                                                                                              owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_00002473>
                                                                                            ]
                                                                                          ) ;
                                                                       rdf:type owl:Class
                                                                     ] ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00001158> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                                                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/FOODON_00002473>
                                                                 ] ;
                                                 rdfs:label "apple food product"@en .


###  http://purl.obolibrary.org/obo/FOODON_00002403
<http://purl.obolibrary.org/obo/FOODON_00002403> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "Any substance that can be consumed by an organism to satisfy nutritional or other health needs, or to provide a social or organoleptic food experience"@en ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000119> <https://en.wikipedia.org/wiki/Food> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/ons.owl> ;
                                                 <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "food"@en ,
                                                                                                                "foodstuff"@en ;
                                                 <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "nourishment"@en ,
                                                                                                                 "sustenance"@en ;
                                                 rdfs:comment "This class is the top of FOODON's main food product hierarchy which is described in the https://www.foodon.org website, and can be searched in lookup services like https://www.ebi.ac.uk/ols/"@en ;
                                                 rdfs:label "food material"@en .


###  http://purl.obolibrary.org/obo/FOODON_00002454
<http://purl.obolibrary.org/obo/FOODON_00002454> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_00002403> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "Food material which has been categorized by a characteristic such as granularity or temperature."@en ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000117> "Damion Dooley"@en ;
                                                 rdfs:comment "This term was renamed from \"food product by quality\" to align better with COB \"characteristic\" label, and as well to disambiguate from other use of \"quality\" as a food grading. This term is useful for tasks like food inspection where little prior knowledge of how the food came to be is available. Some terms like \"food (frozen)\"are both a quality descriptor and the output of a process."@en ;
                                                 rdfs:label "food material by characteristic"@en .


###  http://purl.obolibrary.org/obo/FOODON_00002473
<http://purl.obolibrary.org/obo/FOODON_00002473> rdf:type owl:Class ;
                                                 owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/PO_0030110>

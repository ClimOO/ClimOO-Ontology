                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/PATO_0001995> ;
                                                 <http://purl.obolibrary.org/obo/IAO_0000115> "A characteristic of organism material which has a biochemical composition that closely resembles its harvested or subsequent biologically aged state."@en ;

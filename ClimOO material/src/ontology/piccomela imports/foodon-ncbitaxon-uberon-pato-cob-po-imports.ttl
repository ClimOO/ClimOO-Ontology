###  http://purl.obolibrary.org/obo/FOODON_00002559
<http://purl.obolibrary.org/obo/FOODON_00002559> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.obolibrary.org/obo/FOODON_03411245> ;

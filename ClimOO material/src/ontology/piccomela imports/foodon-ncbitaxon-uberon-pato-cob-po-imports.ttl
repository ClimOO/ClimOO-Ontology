<https://ClimOO/climoo/climoo-piccomela/imports/foodon-ncbitaxon-uberon-pato-cob-po-imports> rdf:type owl:Ontology ;
                                                                                              owl:versionIRI <https://ClimOO/climoo/climoo-piccomela/imports/foodon-ncbitaxon-uberon-pato-cob-po-imports#2026-11-02> ;
                                                                                              rdfs:comment """This file contains ClimOO Ontology suite imports from Food Ontology (FoodOn), Core Ontology for Biology and Biomedicine (COB), Uber Anatomy Ontology (UBERON), Plant Ontology (PO), Phenotype And Trait Ontology (PATO), and NCBI organismal classification (NCBITaxon). Imports were manually collected and revised.

Ontology source: http://purl.obolibrary.org/obo/foodon.owl"""@en ;
                                                                                              rdfs:seeAlso """http://purl.obolibrary.org/obo/uberon.owl
http://purl.obolibrary.org/obo/po.owl
http://purl.obolibrary.org/obo/cob.owl 
http://purl.obolibrary.org/obo/ncbitaxon.owl
http://purl.obolibrary.org/obo/pato.owl""" ;
                                                                                              owl:versionInfo "2026-11-02" .


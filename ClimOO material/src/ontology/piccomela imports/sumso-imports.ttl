                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
                                       rdfs:subClassOf <https://www.w3id.org/sco#SCO_0000036> ;
                                       rdfs:label "food system stakeholder"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A food system component with a stakeholder role."@en ;
                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://w3id.org/sumso#SuMSO_0000027
<https://w3id.org/sumso#SuMSO_0000027> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://www.w3id.org/sco#SCO_0000022> ,
                                                       [ owl:intersectionOf ( <https://www.w3id.org/sco#SCO_0000022>
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/sco#SCO_0000037> ;
                                                                                owl:someValuesFrom <https://w3id.org/sumso#SuMSO_0000025>
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;

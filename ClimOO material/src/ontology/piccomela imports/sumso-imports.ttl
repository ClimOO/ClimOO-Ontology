                                                                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                    owl:unionOf ( <https://w3id.org/sumso#SuMSO_0000025>
                                                                                                                  <https://w3id.org/sumso#SuMSO_0000032>
                                                                                                                )
                                                                                                  ]
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                       rdfs:label "interaction between food system components and food system environment components"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "An interaction between complex system components and complex system environment components that occurs between at least one food system component and one food system environment component where the latter belongs to the food system environment of the food system to which the food system component belongs."@en ;
                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://w3id.org/sumso#SuMSO_0000030
<https://w3id.org/sumso#SuMSO_0000030> rdf:type owl:Class ;

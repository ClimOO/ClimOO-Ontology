                                                                owl:versionIRI <http://ClimOO/climoo/climoo-piccomela/imports/sumso-imports#26-10-09> ;
                                                                <http://purl.org/dc/terms/description> """This file contains ClimOO ontology suite imports from the Sustainable Meat Systems Ontology (SuMSO). Imports have been manually collected and revised.

Ontology source: SuMSO V1.0.1.
https://w3id.org/sumso"""@en ;
                                                                rdfs:seeAlso "https://w3id.org/sumso/repo" ;
                                                                owl:versionInfo "2026-10-09" .


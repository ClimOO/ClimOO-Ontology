<https://ClimOO/climoo/climoo-piccomela/imports/cob-envo-pco-ncbitaxon-imports> rdf:type owl:Ontology ;
                                                                                 owl:versionIRI <https://ClimOO/climoo/climoo-piccomela/imports/cob-envo-pco-ncbitaxon-imports#2026-10-30> ;
                                                                                 rdfs:comment """This file contains ClimOO Ontology suite imports from Environment Ontology (EnvO), Core Ontology for Biology and Biomedicine (COB), Population and Community Ontology (PCO), and NCBI organismal classification (NCBITaxon). Imports were manually collected and revised.

Ontology source: http://purl.obolibrary.org/obo/envo/releases/2026-10-23/envo.owl"""@en ;
                                                                                 rdfs:seeAlso """http://purl.obolibrary.org/obo/envo.owl 
http://purl.obolibrary.org/obo/pco.owl 
http://purl.obolibrary.org/obo/cob.owl 
http://purl.obolibrary.org/obo/ncbitaxon.owl""" ;
                                                                                 owl:versionInfo "2026-10-30" .


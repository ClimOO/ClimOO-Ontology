                                                         owl:allValuesFrom :ClimOO_0000036
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ,
                                _:genid167 ;
                rdfs:comment "We currently focus our system of analysis on activities up to harvesting activities in the agricultural supply chains."@en ,
                             """We included the SuMSO food system classes to provide users with an initial reference backbone hierarchy in case they need to model the relation between agricultural and food systems. 

The agricultural system class may be considered a potential subclass of the SuMSO food system class, according to the provided definitions. We refrain from adding the subsumption axiom because not all agricultural systems are oriented towards food production for humans, and while the SuMSO definition presents an overarching applicability beyond human focus, classifying all agricultural systems in this manner would be unconventional. In fact, the term “food system” is usually only used to refer to food for humans and not to food for animals."""@en ;
                rdfs:label "agricultural system"@en ;
                rdfs:seeAlso "http://purl.obolibrary.org/obo/ENVO_01000311" ;
                <http://www.w3.org/2004/02/skos/core#definition> "A complex system where humans raise animals and grow plants on land for harvest and consumption (harvest and consumption for both humans and animals)."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/ENVO_0000007; http://purl.obolibrary.org/obo/ENVO_01001246" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .

_:genid167 rdf:type owl:Restriction ;
            owl:onProperty :ClimOO_0000366 ;
            owl:someValuesFrom <https://www.w3id.org/climoo/climoo-sdc2#ClimOO_0000298> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ClimOO_0000364 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid167 ;
   rdfs:comment "We envision implementations to characterize the relations between these systems  with respect to components, interactions, boundaries, development, and history."@en
 ] .



<https://www.w3id.org/climoo/climoo-piccomela> rdf:type owl:Ontology ;
                                                owl:versionIRI :piccomela-v1.0.0 ;
                                                owl:imports <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/cco-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/chebi-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/cob-envo-pco-ncbitaxon-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/foodon-ncbitaxon-uberon-pato-cob-po-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/iao-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/pato-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/sumso-imports.ttl> ,
                                                            <https://raw.githubusercontent.com/ClimOO/ClimOO-Ontology/refs/heads/main/ClimOO%20material/src/ontology/piccomela%20imports/transformon-imports.ttl> ,
                                                            <https://www.w3id.org/climoo/climoo-picco#picco-v1.0.0> ;
                                                <http://purl.org/dc/terms/contributor> "Ludger Jansen; Giorgio A. Ubbiali" ;
                                                <http://purl.org/dc/terms/creator> "Giorgio A. Ubbiali" ;
                                                <http://purl.org/dc/terms/description> "ClimOO Ontology is a reference ontology, modeling plastics, (micro-)plastic pollution, climate change, and their interrelation, with a primary focus on agricultural systems. The ClimOO Ontology is structured in a suite of nested ontological modules. The PICCOmela module applies the Plastics Interconnecting with Climate Change Ontology (PICCO) module to agriculture systems, especially to apple production. The main use case of reference is the local agricultural production of apple in South Tyrol (Italy)."@en ;
                                                <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                                                <http://purl.org/dc/terms/title> "ClimOO Ontology - PICCOmela module"@en ;
                                                owl:versionInfo "2026-07-16"@en ,
                                                                "V1.0.0."@en ;
                                                <http://www.w3.org/2004/02/skos/core#note> """Repository: https://www.w3id.org/climoo/repo
Documentation webpage: https://www.w3id.org/climoo/docs"""@en ,
                                                                                           "The most recent version of this file is available on GitHub at the following link: https://www.w3id.org/climoo/climoo-piccomela."@en .


                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                rdfs:label "agricultural process"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/ENVO_01001246" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000513
:ClimOO_0000513 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000515 ;
                rdfs:label "apple farming process"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agricultural process that occurs in an apple farming system for the sake of apple growth, production, and harvest."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000514
:ClimOO_0000514 rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/sumso#SuMSO_0000069> ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "apple grower, apple producer"@en ;
                rdfs:label "apple farmer"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A farmer who is involved in the growing, harvest, and production of apples."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000515
:ClimOO_0000515 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
                rdfs:comment "Agricultural fieds are complex systems themself." ;
                rdfs:label "agricultural field"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A fiat object part that is a continuous expanse of land, part of an agricultural system, and is used for agricultural purposes, usually animal grazing and crop cultivation."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/ENVO_00000114;http://purl.obolibrary.org/obo/ENVO_01000352." ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000516
:ClimOO_0000516 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000515 ;
                rdfs:label "apple orchard field"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agricultural field that is part of an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000517
:ClimOO_0000517 rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000001> ;
                rdfs:label "portion of agricultural field"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A portion of matter that is part of or originates from an agricultural field."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000518
:ClimOO_0000518 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000517 ;
                rdfs:label "portion of orchard field"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A portion of agricultural field that is part of or originates from an orchard field."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000519
:ClimOO_0000519 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000520 ;
                rdfs:comment "cutting grass among tree; Unkrautmanagement; different techniques and machines are employed."@en ;
                rdfs:label "mowing in apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A mowing in agriculture that occurs in an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000520
:ClimOO_0000520 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000512 ;
                rdfs:label "mowing in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agricultural process that results in cutting plants, usually weeds or grass, from the surface of an agricultural field."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/AGRO_00000220" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000521
:ClimOO_0000521 rdf:type owl:Class ;
                rdfs:subClassOf <http://opendata.inrae.fr/PO2/Ontology/TransformON/c_YjqYhO> ;
                rdfs:label "apple packaging"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A packaging process that applies to some apples."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000522
:ClimOO_0000522 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000514 ;
                rdfs:label "apple storing in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process that results in the collection and preservation of apples, often in boxes, usually prior to retail and sale, in an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000523
:ClimOO_0000523 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                rdfs:comment " We recreated this class on the basis of the corresponding GO class. GO axiomatizes the upper-level class “growth” with respect to the class “biological phase”, which presents axioms beyond the purposes of ClimOO. We envision discussions with subject matter experts. This class may be deprecated in favor of a more general class implemented in GO after discussions. We subsume this class under the BFO:process class, which is the direct upper-level class of the corresponding GO class."@en ;
                rdfs:label "developmental growth"@en ;
                rdfs:seeAlso "http://purl.obolibrary.org/obo/GO_0040007; http://purl.obolibrary.org/obo/GO_0044848; http://purl.obolibrary.org/obo/GO_0032502." ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that increases an integrated living unit, such as an entire organism, part of an organism, or a cell, in size and mass, contributing to its progression over time from one condition to another."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/GO_0048589" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000524
:ClimOO_0000524 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000523 ;
                rdfs:comment "From an agricultural point of view, this phase corresponds to the first 3 years when farmers wait to harvest the apple tree."@en ;
                rdfs:label "apple tree growth process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A growth process of an apple tree in an orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000525
:ClimOO_0000525 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                rdfs:comment "From an agricultural point of view, production covers the steps from tree planting to apple harvesting and preparation for the market, and possibly fruit selling, according to the context."@en ;
                rdfs:label "apple production process"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process that results in securing apples for retail and sale."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000526
:ClimOO_0000526 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000523 ;
                rdfs:comment "From an agricultural point of view, this phase includes fruit growing, tree preparation, and plant and fruit supervision."@en ;
                rdfs:label "apple growth process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A growth process of an apple in a orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000527
:ClimOO_0000527 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                rdfs:label "apple tree planting process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process that results in an apple plant being set into a portion of soil in an orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/AGRO_00000231; http://purl.obolibrary.org/obo/AGRO_00000032"@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000528
:ClimOO_0000528 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "apple harvest; apple harvesting"@en ;
                rdfs:label "apple harvesting process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process in which apples are gathered from an apple tree in an orchard. The moment and apple conditions and qualities for harvest are defined by the farmer, accroding ot experience and possible standards."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/AGRO_00000025" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000529
:ClimOO_0000529 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                rdfs:label "apple tree binding process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process in which training bands are employed to guide apple tree growth in an orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000530
:ClimOO_0000530 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "apple tree pruning"@en ;
                rdfs:label "apple tree cutting in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process in which certain parts of an apple tree or plant, such as branches and leaves, are selectively removed in an orchard for agricultural purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/AGRO_00000566" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000531
:ClimOO_0000531 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000513 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "apple tree fertilization; fertilizer application to apple tree in orchard"@en ;
                rdfs:label "apple tree fertilizing process in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An apple farming process in which an apple tree in an orchard is treated with fertilizers to promote plant growth and health."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://purl.obolibrary.org/obo/AGRO_01000000" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000532
:ClimOO_0000532 rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/CalendarYear> ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "year of the tree"@en ;
                rdfs:label "tree age"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A calendar year that extends from the plant's birth (germination or grafting in the nursery) to the moment when the plant's age is measured, via methods such as plant circumference measurements and counting the number of plant growth rings."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000533
:ClimOO_0000533 rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/CalendarYear> ;
                rdfs:label "year of tree plantation"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A calendar year that corresponds to the year during which an apple tree has been planted."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000534
:ClimOO_0000534 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000540 ;
                rdfs:label "agriplastic usage process for extending apple tree seasonality in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastics in an apple orchard that aims to broaden the time period within which apples are produced and harvested in an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000535
:ClimOO_0000535 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000540 ;
                rdfs:label "agriplastic usage process for apple tree protection"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastics in an apple orchard that aims to safeguard apple trees from adverse occurrences, including climate events, plant diseases, or harm caused by animals."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000536
:ClimOO_0000536 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000540 ;
                rdfs:label "agriplastic usage process to reduce water demand in apple production"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastics in an apple orchard that aims to diminish the water used for agricultural purposes during the production of apples."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000537
:ClimOO_0000537 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000540 ;
                rdfs:label "agriplastic usage process in apple tree growth and management"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastics in an apple orchard that aims to guide, handle, control, and achieve adequate apple tree growth and development to optimize apple production and harvest."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000538
:ClimOO_0000538 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000539 ;
                rdfs:label "usage process of agriplastics in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastic that occurs in an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000539
:ClimOO_0000539 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-plastico#ClimOO_0000222> ;
                rdfs:label "usage process of agriplastics"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of some piece of synthetic polymer-based material that has, as the main participant, an agriplastic object."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000540
:ClimOO_0000540 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000539 ;
                rdfs:label "usage process of agriplastics in apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A usage process of agriplastics in agriculture that occurs in an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000541
:ClimOO_0000541 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/COB_0000035> ;
                rdfs:label "process of reducing agriplastic usage in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A completely executed planned process that results in the turning down of the usage of agriplastic in an agricultural system, generally in favor of alternatives, usually considered more environmentally friendly."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000542
:ClimOO_0000542 rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/climoo/climoo-plastico#ClimOO_0000467> ;
                rdfs:label "process of reducing plastic pollution in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process of reducing plastic pollution that occurs in an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000543
:ClimOO_0000543 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000542 ;
                rdfs:label "process of reducing agriplastic pollution in agriculture"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process of reducing plastic pollution in agriculture that limits the release and possible accumulation of agriplastic debris particles."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000544
:ClimOO_0000544 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000543 ;
                rdfs:label "process of reducing agriplastic pollution in apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process of reducing agriplastic pollution in agriculture that occurs in an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000545
:ClimOO_0000545 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000479 ;
                rdfs:label "plastic pollution in apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plastic pollution process in agriculture that occurs in an apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000546
:ClimOO_0000546 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000545 ;
                rdfs:label "plastic pollution in soils of apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plastic pollution process in apple orchard that occurs in a portion of the soil of that apple orchard."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000547
:ClimOO_0000547 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-picco#ClimOO_0000440> ;
                rdfs:comment "e.g pH, porosity, soil bulk, soil structure, soil enzyme activity, soil water, microbial population, composition, and diversity."@en ;
                rdfs:label "agriplastic debris-driven alteration process of agricultural soil properties in apple orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plastic debris-driven alteration process of soil properties that occurs in an agricultural soil of an apple orchard caused by some agriplastic debris particles."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000548
:ClimOO_0000548 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-picco#ClimOO_0000425> ;
                rdfs:label "biofilm formation process on agridebris particle in agricultural soils"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A biofilm formation process on soil plastic debris that occurs on agriplastic debris in agricultural soil."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000549
:ClimOO_0000549 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-plastico#ClimOO_0000203> ;
                rdfs:label "release process of agriplastic debris-carried pollutants in orchards"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A release process of plastic debris-carried pollutants into the environment that occurs in an orchard. Debris and pollutant molecules can already be in the orchard or originate from outside."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000550
:ClimOO_0000550 rdf:type owl:Class ;
                rdfs:subClassOf <https://www.w3id.org/climoo/climoo-picco#ClimOO_0000422> ;
                rdfs:comment "Microplastic particles can derive from agriplastics or other plastic sources."@en ;
                rdfs:label "apple tree uptake process of microplastic debris in orchards"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plant uptake process of microplastics that occurs in an orchard, and microplastic particles enter an apple tree."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000551
:ClimOO_0000551 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:label "plastic debris-driven alteration process of apple tree growth in orchard"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in an orchard caused by some plastic debris and has as its output an apple tree part of the orchard exhibiting a different growth pattern."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000552
:ClimOO_0000552 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:label "aeration agricultural soil pore obstruction process by agripastic debris"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that has as its output a portion of agricultural soil with some aeration pore spaces blocked by some agriplastic debris."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000553
:ClimOO_0000553 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                rdfs:label "agricultural soil nutrient cycling impediment process"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that has as its output a portion of agricultural soil where nutrients, such as carbon and nitrogen, cannot cycle (participate in a cycling process)."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000554
:ClimOO_0000554 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "animal entrapment with agriplastics in apple orchards"@en ;
                rdfs:label "animal entanglement process with agriplastics in apple orchards"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A process that occurs in an apple orchard and results in animals being entrapped in agriplastic objects or related debris."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000555
:ClimOO_0000555 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:label "agriplastic film"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a laminar sheet employed for different agricultural purposes, including plant protection, sillage, and mulching."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000556
:ClimOO_0000556 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000555 ;
                rdfs:label "apple orchard reflective film"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic film that is used in apple orchards to redirect light to the target tree zones to vary apple coloration, according to certain stakeholder purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000557
:ClimOO_0000557 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:comment "Apple orchard: Spindle training system(practice); the system includes the use of binding objects to guide tree growth; a part of the step is plastic binding (other steps: cutting the tree)."@en ;
                rdfs:label "agriplastic binding object for agricultural plant growth and training"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is used within an agricultural system to attach and connect plants to supportive structures to guide and train the plant growth according to some agricultural purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000558
:ClimOO_0000558 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:comment "Details of different types of compositions, properties, and characteristics can be added as needed."@en ;
                rdfs:label "agriplastic net"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is constituted by threads connected together with each other, in a woven or knitted way, forming a regular porous geometric structure that allows fluids (gases and liquids) to pass through. A net is used for different agricultural purposes, including plant protection and harvest."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "10.13031/2013.25368" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000559
:ClimOO_0000559 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000558 ;
                rdfs:comment "The net is applicable to all trees of an orchard or to a single one."@en ;
                rdfs:label "agriplastic net for protection from meteorological hazards"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic net that is used to protect cultivations from possible hail and weather threats, including wind, hail, snow, frost, and rain within an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000560
:ClimOO_0000560 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000558 ;
                rdfs:comment "The net is applicable to all trees of an orchard or to a single one."@en ;
                rdfs:label "agriplastic net for protection from animals"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic net that is used to protect cultivations from damage from animals, including insects, birds, rabbits, and mice, within an agricultural system."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000561
:ClimOO_0000561 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000558 ;
                rdfs:comment "To make borders among orchards; to stop and cluster liquid fertilizing on one specific orchard and not make it spread around; very fine grain in the nets, used if there is not space for siepi (other tree, no fruit trees)."@en ;
                rdfs:label "agriplastic net for fertilizer management in apple orchards"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic net that is used to guide fertilization and cluster it to (portions of) orchards of interest, within an agricultural system, according to some stakeholder purposes. It is usually a very fine-mesh net, used to divide orchards when bush hedges are not present."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000562
:ClimOO_0000562 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:comment "Details about the different types of systems can be added as needed."@en ;
                rdfs:label "drainage agriplastic pipe"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a long tubular structure used to remove water from a desired location, within an agricultural system, according to some stakeholder purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://www.britannica.com/topic/drainage" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000563
:ClimOO_0000563 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000588 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "irrigation agriplastic tube"@en ;
                rdfs:label "irrigation agriplastic pipe"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object for irrigation that is a long tubular structure used to move and distribute water from a source to a desired location, usually fields, within an agricultural system, according to some stakeholder purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000564
:ClimOO_0000564 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:label "agriplastic tube for pheromone distribution"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a tubular structure used to dispense and manage pheromones in agricultural fields to interfere with pest reproductive behaviors and safeguarde cultivations present in those fields."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000565
:ClimOO_0000565 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:label "fertilizer agriplastic tube"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a tubular structure used to contain and distribute fertilizers on cultivations in agricultural fields."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000566
:ClimOO_0000566 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                <http://purl.org/dc/terms/source> "https://doi.org/10.4060/cb7856en; https://naturalresources.extension.iastate.edu/post/tree-cages-tree-shelters-very-quick-overview-pros-and-cons; https://assets.publishing.service.gov.uk/media/5ef9b9ded3bf7f76970eed47/Tree_shelters_guide.pdf" ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "tree guard"@en ;
                rdfs:label "tree guard agriplastic object"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a holed tubular lamina to be wrapped around the base of newly planted trees (mono-use) to support their establishment and growth, and protect them from potential damage, including weather and animal damage. They are fixed to plants usually with clips, ties, or cables."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000567
:ClimOO_0000567 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                <http://purl.org/dc/terms/source> "https://doi.org/10.4060/cb7856en; https://naturalresources.extension.iastate.edu/post/tree-cages-tree-shelters-very-quick-overview-pros-and-cons; https://assets.publishing.service.gov.uk/media/5ef9b9ded3bf7f76970eed47/Tree_shelters_guide.pdf" ;
                <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "tree tube agriplastic object; tree tube; tree protection tube"@en ;
                rdfs:label "tree shelter agriplastic object"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is a semi-rigid tubular lamina to be wrapped around the base of newly planted trees (mono-use) to support their establishment and growth, and protect them from potential damage, including weather and animal damage. It also generates a controlled microclimate for the plant. It is usually fixed to plants with clips, ties, or cables."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000568
:ClimOO_0000568 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "plastic box for fertilizer"@en ;
                rdfs:label "agriplastic pot for fertilizer"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A box that is an agriplastic object and contains fertilizers for use in agriculture."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000569
:ClimOO_0000569 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                rdfs:label "agriplastic box"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A box that is an agriplastic object and is used primarily for agricultural purposes."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000570
:ClimOO_0000570 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "packaging"@en ;
                rdfs:label "packaging object"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A product that is designed to envelop and contain a product or commodity."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://addictovocab.org/ADDICTO_0001235" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000571
:ClimOO_0000571 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000570 ;
                rdfs:label "apple agriplastic packaging object"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is designed to contain apples for selling."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000572
:ClimOO_0000572 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000096 ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "product, agriplastics"@en ;
                rdfs:label "agriplastic product"@en ;
                rdfs:seeAlso "https://w3id.org/pmd/co/PMD_0000833; http://purl.obolibrary.org/obo/ENVO_01000993; http://purl.obolibrary.org/obo/ENVO_00003074; https://journals.sagepub.com/doi/abs/10.3233/AO-190210" ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic object that is an output of a manufacturing process of a piece of synthetic polymer-based material."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000573
:ClimOO_0000573 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0020000> ;
                rdfs:label "agriplastic product name"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An identifier that provides the commercial designation of an agriplastic product, as by the retailer or manufacturer."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000574
:ClimOO_0000574 rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/InformationContentEntity> ;
                rdfs:label "agriplastic product price"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An information content entity that is about the amount of money associated with, and that a consumer is willing to pay for, a unit of agriplastic product(s)."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "http://www.eionet.europa.eu/gemet/concept/6602" ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000575
:ClimOO_0000575 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000574 ;
                rdfs:label "standardized agriplastic product price - LRC"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic product price that has been normalized for comparison purposes by the Laimburg Research Centre (LRC)."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000576
:ClimOO_0000576 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
                rdfs:label "agriplastic product lifespan"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A temporal interval within which an agriplastic product maintains its functionalities for the intended applications, according to manufacturer specifications."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000577
:ClimOO_0000577 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000182> ;
                rdfs:label "agriplastic product history"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A history of an agriplastic product."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000578
:ClimOO_0000578 rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/DescriptiveInformationContentEntity> ;
                rdfs:label "agriplastic product duration of application"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A descriptive information content entity that describes the time interval within which an agriplastic product can be employed in its typical intended applications before being damaged or deteriorating. It generically depends on the material composition of the agriplastic product."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000579
:ClimOO_0000579 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000578 ;
                rdfs:label "long-term agriplastic product duration of application"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic product duration of application that describes a time interval longer than one year (counted from the first product deployment for its designed application; the product is in good factory-fresh condition and not damaged). Reference: LRC."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000580
:ClimOO_0000580 rdf:type owl:Class ;
                rdfs:subClassOf :ClimOO_0000578 ;
                rdfs:label "short-term agriplastic product duration of application"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An agriplastic product duration of application that describes a time interval of less than one year, usully one apple growing season (counted from the first product deployment for its designed application; the product is in good factory-fresh condition and not damaged). Reference: LRC."@en ;
                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/maturity> <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/Released> .


###  https://www.w3id.org/climoo/climoo-piccomela#ClimOO_0000581
:ClimOO_0000581 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                rdfs:label "agriplastic product disposition to single-use"@en ;

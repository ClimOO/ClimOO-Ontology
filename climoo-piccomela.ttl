                             owl:unionOf ( <http://purl.obolibrary.org/obo/RO_0002577>
                                           <https://www.w3id.org/sco#SCO_0000006>
                                         )
                           ] ;
                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "has subsystem at all times"@en ;
                rdfs:label "is a supersystem of at all times"@en ;
